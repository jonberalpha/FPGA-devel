// Tang Primer 20K core board + Dock (GW2A-LV18PG256C8/I7) - LED example
// Clock H11 from core-board schematic; Dock LED/key pins from community lists - verify.
IO_LOC "clk_27mhz" H11;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// S0 = reset (first button), S1 = blink on/off
IO_LOC "btn_rst" T10;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "btn_user" T3;
IO_PORT "btn_user" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Dock LEDs, active low. C13/A13 (READY/DONE config pins) are not used.
IO_LOC "led[0]" L16;
IO_LOC "led[1]" L14;
IO_LOC "led[2]" N14;
IO_LOC "led[3]" N16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 DRIVE=8;
