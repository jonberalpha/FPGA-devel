// Tang Primer 20K core board + Dock (GW2A-LV18PG256C8/I7) - mc8051 button/LED demo
// Clock H11 (27 MHz) from core-board schematic; Dock LED/key pins from
// community pin lists - verify against the Dock schematic (see README).

IO_LOC "clk_27mhz" H11;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// S0 = reset (first button), S1 = user button (P1.0). Pressed = low.
IO_LOC "btn_user" T3;
IO_PORT "btn_user" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "btn_rst" T10;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Dock LEDs, active low. led[0] = L16 = LED5 (top LED on the Dock).
// C13/A13 are READY/DONE config pins and are deliberately not used.
IO_LOC "led[0]" L16;
IO_LOC "led[1]" L14;
IO_LOC "led[2]" N14;
IO_LOC "led[3]" N16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 DRIVE=8;
