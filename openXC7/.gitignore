# --- Build outputs (regenerated by `make`) --------------------------------
build/

# --- Cached/generated chip database (regenerated by `make`) ---------------
**/tools/chipdb/

# --- Transient chipdb-build intermediate (lands in the project root, not
# tools/chipdb/, if a build is interrupted between bbaexport.py and the
# Makefile's own `rm -f`) --------------------------------------------------
*.bba

# --- Downloaded toolchains & cloned dependency repos (fetched by sw/build.sh) ---
**/sw/arm-gnu-toolchain-*/
**/sw/arm-gnu-toolchain-*.tar.xz
**/sw/embeddedsw/
**/sw/zynq-mkbootimage/
**/sw/*.bif

# --- toolchain-installer clone (cloned by install-openxc7.sh, not needed after build) ---
/toolchain-installer/

# --- Editor/OS cruft --------------------------------------------------------
*.swp
*~
.DS_Store
